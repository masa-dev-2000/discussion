{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "既定の権限。ローカル LLM と OpenAI 互換 API への HTTP を許可する。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/" },
        { "url": "http://127.0.0.1:*/" },
        { "url": "https://*/" }
      ]
    }
  ]
}
